# ======================================================================
#  使用守护 · 管理后台 配置文件
#
#  用法：复制本文件为 config.env，按需修改。
#      cp config.env.example config.env && chmod 600 config.env
#  改完执行  sh run.sh  （会自动重启生效）
#
#  注意：等号两边不要加空格；值里不要加引号（除非确实需要）。
# ======================================================================

# 内置管理员 admin 的【初始】口令 —— 只在第一次启动、创建账号时生效。
# 之后再改这一行不会生效：请登录后台点右上角「我的账号」改密码。
# 公网部署时第一次启动就该改掉，别留着默认值。
GUARDIAN_ADMIN_PASSWORD=请改成一个长一点的随机口令

# 监听端口。默认 0.0.0.0:8000 表示所有网卡都可访问
GUARDIAN_PORT=8000
GUARDIAN_HOST=0.0.0.0

# 如果只想让本机/反向代理访问，可以改成：
# GUARDIAN_HOST=127.0.0.1
# 或者直接写完整地址（优先级高于上面两行）：
# GUARDIAN_ADDR=0.0.0.0:8000

# 数据库位置（默认 ./data/guardian.db，SQLite 文件）
# 从 v2.1.x 升级时如果这里还写着 state.json，程序会自动改用同目录的 .db，
# 并把那个 json 当作迁移源读一次（原文件不会丢）。
# GUARDIAN_DATA=/opt/guardian/data/guardian.db

# 统计"今天"用的时区偏移小时数，北京时间是 8
# GUARDIAN_TZ_OFFSET=8

# 后台登录有效期（天）
# GUARDIAN_SESSION_DAYS=7
