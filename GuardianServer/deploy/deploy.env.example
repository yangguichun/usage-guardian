# ======================================================================
#  「使用守护」服务端 —— 远程部署配置
#
#  用法：
#    1. 把这个文件复制成 deploy.env（同一个目录）
#    2. 填上你的服务器信息
#    3. 在 GuardianServer/ 目录下跑：
#         python deploy/deploy.py --check     # 先体检，不改任何东西
#         python deploy/deploy.py             # 正式部署
#
#  注意：deploy.env 里有密码，别提交到公开仓库。
# ======================================================================

# ---- 服务器 ----
GUARDIAN_SSH_HOST=1.2.3.4
GUARDIAN_SSH_PORT=22
GUARDIAN_SSH_USER=root

# ---- 认证（二选一，两个都填则用密码解锁私钥）----
GUARDIAN_SSH_PASSWORD=
# 例如 /root/.ssh/id_rsa 或 ~/.ssh/id_rsa
GUARDIAN_SSH_KEY=

# ---- 安装位置 ----
# 服务端程序所在的目录（里面有 guardian-server / run.sh / data/）
# ★ 必须和服务器上的实际目录**完全一致**。写错了不会报错，会在一个新目录里
#   全新装一份，然后因为 8000 端口被老进程占着起不来。
#   拿不准就先跑 `python deploy/deploy.py --check` 看它报的"现有数据库"路径对不对，
#   或者跑 `python deploy/diag.py` 把现有安装目录列出来（只读）。
# 另外：建议写在这个文件里，不要用命令行 --path 传 —— Windows 的 Git Bash 会把
# 以 / 开头的参数改写成 C:/Program Files/Git/... ，脚本会报错拦下来。
GUARDIAN_REMOTE_PATH=/opt/guardian-server

# ---- 服务端口（用于部署后的健康检查）----
GUARDIAN_HTTP_PORT=8000
